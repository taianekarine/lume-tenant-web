LUME_TENANT_API_URL=http://localhost:3333/api/v1
LUME_TENANT_API_TIMEOUT_MS=5000
SESSION_SECRET=replace-with-at-least-32-random-characters

# Simulação é permitida apenas fora de produção e deve ser ativada explicitamente.
AUTH_SIMULATION_ENABLED=false

# O padrão é "api". "mock" exige ativação explícita e é recusado em production.
# Use mock somente em testes automatizados ou desenvolvimento isolado.
LUME_TENANT_WHATSAPP_DATA_SOURCE=api

NEXT_PUBLIC_TENANT_NAME=Milenium
NEXT_PUBLIC_TENANT_PRODUCT_NAME=Milenium Lume
NEXT_PUBLIC_TENANT_LOGO_URL=/logo-milenium.png
NEXT_PUBLIC_TENANT_PRIMARY_COLOR="#1d4ed8"
